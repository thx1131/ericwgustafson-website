---
import Layout from '../layouts/Layout.astro';
import PublicationCard from '../components/PublicationCard.astro';
import publications from '../data/publications.json';

const books = publications.filter((p) => p.status === 'available');
const others = publications
  .filter((p) => p.status !== 'available')
  .sort((a, b) => (b.year ?? -Infinity) - (a.year ?? -Infinity));
---

<Layout
  title="Publications — Eric Gustafson"
  description="Books, writings, and conservation reports published by Eric Gustafson, including Mexico Viking."
>
  <section class="section">
    <div class="container">
      <div class="section-heading section-heading--underline">
        <h1>Publications</h1>
        <p class="section-lead">Published works by Eric Gustafson.</p>
      </div>

      <h2 class="group-heading">Books</h2>
      <div class="grid-books">
        {books.map((publication) => <PublicationCard publication={publication} />)}
      </div>
    </div>
  </section>

  <section class="section section--muted">
    <div class="container">
      <h2 class="group-heading">Selected Writings &amp; Contributions</h2>
      <div class="grid-others">
        {others.map((publication) => <PublicationCard publication={publication} compact />)}
      </div>
    </div>
  </section>
</Layout>

<style>
  .section-lead {
    color: var(--color-text-muted);
    max-width: 60ch;
  }

  .group-heading {
    margin-bottom: var(--space-lg);
  }

  .grid-books {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-xl);
    margin-bottom: var(--space-2xl);
  }

  @media (min-width: 640px) {
    .grid-books {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .grid-others {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-lg) var(--space-xl);
  }

  @media (min-width: 640px) {
    .grid-others {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .grid-others {
      grid-template-columns: repeat(4, 1fr);
    }
  }
</style>
