---
import Layout from '../layouts/Layout.astro';
import CardLibro from '../components/CardLibro.astro';
import libros from '../data/libros.json';

const libroDestacado = libros[0];
---

<Layout title="Eric Gustafson — Author of Mexico Viking">
  <section class="section hero">
    <div class="container hero__inner">
      <div class="hero__text">
        <h1>Eric Gustafson</h1>
        <p class="hero__lead">
          Author of <strong>Mexico Viking</strong>, a novel about Scandinavian and
          Mexican roots, adventure, and the fight for environmental conservation.
        </p>
        <div class="hero__actions">
          <a class="btn btn-primary" href="/publicaciones">View Publications</a>
          <a class="btn btn-secondary" href="/bio">About the Author</a>
        </div>
      </div>
      {
        libroDestacado?.imagen && (
          <div class="hero__cover">
            <img src={libroDestacado.imagen} alt={`Cover of ${libroDestacado.titulo}`} />
          </div>
        )
      }
    </div>
  </section>

  {
    libroDestacado && (
      <section class="section section--muted">
        <div class="container">
          <div class="section-heading section-heading--underline">
            <h2>About the Book</h2>
          </div>
          <div class="book-highlight">
            <p>{libroDestacado.descripcion}</p>
            <a class="btn btn-secondary" href="/publicaciones">
              Read More
            </a>
          </div>
        </div>
      </section>
    )
  }

  {
    libroDestacado && (
      <section class="section">
        <div class="container">
          <div class="section-heading">
            <h2>Latest Release</h2>
          </div>
          <div class="latest-book">
            <CardLibro libro={libroDestacado} />
          </div>
        </div>
      </section>
    )
  }
</Layout>

<style>
  .hero {
    padding-top: var(--space-3xl);
  }

  .hero__inner {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-3xl);
    align-items: center;
  }

  @media (min-width: 768px) {
    .hero__inner {
      grid-template-columns: 3fr 2fr;
      gap: var(--space-4xl);
    }
  }

  .hero__lead {
    font-size: 1.15rem;
    color: var(--color-text-muted);
    max-width: 46ch;
  }

  .hero__actions {
    display: flex;
    gap: var(--space-md);
    flex-wrap: wrap;
    margin-top: var(--space-lg);
  }

  .hero__cover {
    background: var(--color-bg-muted);
    border-radius: var(--radius);
    overflow: hidden;
    aspect-ratio: 2 / 3;
    max-width: 320px;
    margin: 0 auto;
  }

  .hero__cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .book-highlight {
    max-width: 70ch;
  }

  .latest-book {
    max-width: 360px;
  }
</style>
