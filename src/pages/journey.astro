---
import Layout from '../layouts/Layout.astro';
import journey from '../data/journey.json';
import positions from '../data/journeyPositions.json';
import publications from '../data/publications.json';
import BuyButtons from '../components/BuyButtons.astro';

const stops = [...journey].sort((a, b) => a.order - b.order);
const firstStop = stops[0];
const firstPosition = positions[firstStop.id];
const book = publications.find((p) => p.id === 'mexico-viking');
---

<Layout
  title="The Voyages of Nils — Eric Gustafson"
  description="Follow Nils's journey through Mexico, the United States, Alaska, and northern Europe in Mexico Viking."
>
  <section class="section journey-page">
    <div class="container">
      <header class="journey-heading">
        <p class="eyebrow">Mexico Viking</p>
        <h1>The Voyages of Nils</h1>
        <p class="journey-intro">
          Follow Nils through the places, memories, and encounters that shape his life.
        </p>
      </header>

      <div class="journey-layout" data-journey>
        <div class="map-frame" aria-label="Illustrated map of Nils's journey">
          <div class="map-stage" data-map-stage>
          <img
            class="journey-map"
            src="/images/journey/map-world.png"
            alt="Illustrated map showing Mexico and the United States on the left, northern Europe on the right, and Alaska in a separate inset."
            width="3072"
            height="2048"
          />
          <svg class="journey-trail" viewBox="0 0 300 200" preserveAspectRatio="none" aria-hidden="true">
            <path class="journey-trail__halo" data-trail-halo></path>
            <path class="journey-trail__path" data-trail></path>
            {stops.map((stop, index) => (
              <circle
                class="journey-trail__dot"
                data-dot-index={index}
                cx={(positions[stop.id].x / 100) * 300}
                cy={(positions[stop.id].y / 100) * 200}
                r="2.6"
              />
            ))}
          </svg>
          <div
            class="journey-ship"
            aria-hidden="true"
            style={`left: ${firstPosition.x}%; top: ${firstPosition.y}%`}
          >
            <img class="journey-ship__img" src="/images/journey/ship.png" alt="" width="987" height="1011" />
          </div>
          </div>
          <span class="map-caption" aria-hidden="true">A journey across places and years</span>
          <button class="map-camera-toggle" type="button" data-camera-toggle aria-pressed="false">Full route</button>
        </div>

        <section class="journey-finale" data-finale hidden aria-labelledby="finale-title">
          <img class="journey-finale__cover" src="/images/mexico-viking-cover.webp" alt="Mexico Viking book cover" loading="lazy" />
          <div class="journey-finale__body">
            <p class="stop-panel__eyebrow">Voyage complete</p>
            <h2 id="finale-title" tabindex="-1">You sailed all {stops.length} stops with Nils</h2>
            <p class="journey-finale__text">
              From a ranch in Tamaulipas to Alaska, Iceland, and back home to Mexico. Each stop is only a glimpse — the full story is in <em>Mexico Viking</em>.
            </p>
            <div class="journey-finale__actions">
              <BuyButtons amazon={book?.amazon} />
            </div>
            <button class="journey-finale__restart" type="button" data-restart>↺ Sail again from the start</button>
          </div>
        </section>

        <article class="stop-panel">
          <!-- Invisible copies of every stop share one grid cell with the live text,
               so the panel always takes the height of the longest stop and the
               controls below never shift. -->
          <div class="stop-panel__content">
            <div class="stop-panel__live" aria-live="polite" aria-atomic="true">
              <p class="stop-panel__eyebrow" data-stop-date>{firstStop.date ?? 'Date unknown'}</p>
              <h2 data-stop-chapter>{firstStop.chapter}</h2>
              <p class="stop-panel__place" data-stop-place>{firstStop.place}</p>
              <p class="stop-panel__description" data-stop-description>{firstStop.description}</p>
            </div>
            {stops.map((stop) => (
              <div class="stop-panel__sizer" aria-hidden="true">
                <p class="stop-panel__eyebrow">{stop.date ?? 'Date unknown'}</p>
                <p class="stop-panel__sizer-title">{stop.chapter}</p>
                <p class="stop-panel__place">{stop.place}</p>
                <p class="stop-panel__description">{stop.description}</p>
              </div>
            ))}
          </div>
          <div class="journey-controls" aria-label="Journey navigation">
            <span class="journey-progress" aria-hidden="true">
              <span class="journey-progress__fill" data-progress style={`width: ${100 / stops.length}%`}></span>
            </span>
            <button class="control-button" type="button" data-previous aria-label="Previous stop">
              <span class="control-button__arrow" aria-hidden="true">←</span>
              <span class="control-button__label">Previous</span>
            </button>
            <span class="stop-status">
              <span class="stop-count" data-stop-count>01 / {String(stops.length).padStart(2, '0')}</span>
              <span class="swipe-hint" data-swipe-hint aria-hidden="true">Swipe to sail</span>
            </span>
            <button class="control-button" type="button" data-next aria-label="Next stop">
              <span class="control-button__label" data-next-label>Next</span>
              <span class="control-button__arrow" aria-hidden="true">→</span>
            </button>
          </div>
        </article>
      </div>

      <nav class="timeline" aria-label="Journey stops">
        <ol class="timeline__list">
          {stops.map((stop, index) => (
            <li class="timeline__item">
              <button
                class="timeline__stop"
                type="button"
                data-stop-index={index}
                data-stop-id={stop.id}
                data-chapter={stop.chapter}
                data-place={stop.place}
                data-date={stop.date ?? 'Date unknown'}
                data-description={stop.description}
                data-x={positions[stop.id].x}
                data-y={positions[stop.id].y}
                aria-label={`${stop.order}. ${stop.chapter}, ${stop.place}`}
                aria-pressed={index === 0 ? 'true' : 'false'}
                title={`${stop.chapter} — ${stop.place}`}
              >
                <span class="timeline__number">{String(stop.order).padStart(2, '0')}</span>
                <span class="timeline__chapter">{stop.chapter}</span>
              </button>
            </li>
          ))}
        </ol>
      </nav>

      <div class="journey-buy">
        <p class="journey-buy__text">Read the full story in <em>Mexico Viking</em>.</p>
        <div class="journey-buy__actions">
          <BuyButtons amazon={book?.amazon} />
        </div>
      </div>
    </div>
  </section>
</Layout>

<script>
  const root = document.querySelector('[data-journey]');

  if (root) {
    const stops = [...document.querySelectorAll('[data-stop-index]')];
    const ship = root.querySelector('.journey-ship');
    const panel = root.querySelector('.stop-panel');
    const date = root.querySelector('[data-stop-date]');
    const chapter = root.querySelector('[data-stop-chapter]');
    const place = root.querySelector('[data-stop-place]');
    const description = root.querySelector('[data-stop-description]');
    const count = root.querySelector('[data-stop-count]');
    const previous = root.querySelector('[data-previous]');
    const next = root.querySelector('[data-next]');
    const trailPath = root.querySelector('[data-trail]');
    const trailHalo = root.querySelector('[data-trail-halo]');
    const trailDots = [...root.querySelectorAll('.journey-trail__dot')];
    const mapFrame = root.querySelector('.map-frame');
    const controls = root.querySelector('.journey-controls');
    const progress = root.querySelector('[data-progress]');
    const swipeHint = root.querySelector('[data-swipe-hint]');
    const timeline = document.querySelector('.timeline');
    const stage = root.querySelector('[data-map-stage]');
    const cameraToggle = root.querySelector('[data-camera-toggle]');
    const finale = root.querySelector('[data-finale]');
    const finaleTitle = finale.querySelector('h2');
    const nextLabel = root.querySelector('[data-next-label]');
    const nextArrow = next.querySelector('.control-button__arrow');
    const stackedLayout = window.matchMedia('(max-width: 1080px)');
    const phoneLayout = window.matchMedia('(max-width: 680px)');
    let activeIndex = 0;
    let panelTimer;
    let overview = false;

    // Camera: on stacked layouts the map zooms in and follows the ship.
    function cameraScale() {
      if (overview || !stackedLayout.matches) return 1;
      return phoneLayout.matches ? 2.2 : 1.7;
    }

    function updateCamera() {
      const button = stops[activeIndex];
      const scale = cameraScale();
      // A little slack past the map edges keeps stops near the border (Alaska) fully framed.
      const slack = scale === 1 ? 0 : 0.12;
      const clamp = (value) => Math.min(slack, Math.max(1 - scale - slack, value));
      const tx = clamp(0.5 - (Number(button.dataset.x) / 100) * scale) * 100;
      const ty = clamp(0.5 - (Number(button.dataset.y) / 100) * scale) * 100;
      stage.style.transform = `translate(${tx}%, ${ty}%) scale(${scale})`;
      // Shrink the ship against the zoom so it grows only slightly on screen.
      stage.style.setProperty('--ship-factor', scale === 1 ? 1 : 1.4 / scale);
      cameraToggle.hidden = !stackedLayout.matches;
      cameraToggle.textContent = overview ? 'Follow the ship' : 'Full route';
      cameraToggle.setAttribute('aria-pressed', String(overview));
    }

    function showFinale(show) {
      finale.hidden = !show;
      panel.hidden = show;
      root.classList.toggle('is-finished', show);
      overview = show;
      updateCamera();
      if (show) {
        updateTrail(stops.length - 1);
        trailDots.forEach((dot) => dot.classList.remove('is-current'));
        finaleTitle.focus({ preventScroll: true });
        bringStageIntoView();
      }
    }

    function updateNextButton() {
      const isLast = activeIndex === stops.length - 1;
      nextLabel.textContent = isLast ? 'Finish' : 'Next';
      nextArrow.textContent = isLast ? '⚑' : '→';
      next.setAttribute('aria-label', isLast ? 'Finish the voyage' : 'Next stop');
    }

    function updateTrail(index) {
      const points = stops
        .slice(0, index + 1)
        .map((item) => `${(Number(item.dataset.x) / 100) * 300},${(Number(item.dataset.y) / 100) * 200}`);
      const d = points.length > 1 ? `M${points.join(' L')}` : '';
      trailPath.setAttribute('d', d);
      trailHalo.setAttribute('d', d);

      trailDots.forEach((dot, dotIndex) => {
        dot.classList.toggle('is-visited', dotIndex <= index);
        dot.classList.toggle('is-current', dotIndex === index);
      });
    }

    // Restarts a CSS animation class so repeated taps still give feedback.
    function replayClass(element, className) {
      element.classList.remove(className);
      void element.offsetWidth;
      element.classList.add(className);
    }

    // Scrolls only the timeline strip; scrollIntoView would also jump the page vertically.
    function centerTimelineOn(button) {
      const item = button.closest('.timeline__item');
      if (!timeline || !item) return;
      const left = item.offsetLeft - (timeline.clientWidth - item.offsetWidth) / 2;
      timeline.scrollTo({ left, behavior: 'smooth' });
    }

    // Relative moves: stepping past the last stop opens the finale,
    // stepping back from the finale returns to the last stop.
    function step(delta) {
      if (!finale.hidden) {
        if (delta < 0) activate(activeIndex);
        return;
      }
      if (delta > 0 && activeIndex === stops.length - 1) {
        showFinale(true);
        return;
      }
      activate(activeIndex + delta);
    }

    function activate(index) {
      if (!finale.hidden) showFinale(false);

      const boundedIndex = Math.max(0, Math.min(index, stops.length - 1));
      const button = stops[boundedIndex];
      const previousButton = stops[activeIndex];
      if (boundedIndex === activeIndex && index !== activeIndex) {
        replayClass(controls, 'is-bumping');
        return;
      }

      panel.dataset.direction = boundedIndex < activeIndex ? 'back' : 'forward';
      const samePlace =
        boundedIndex !== activeIndex &&
        button.dataset.x === previousButton.dataset.x &&
        button.dataset.y === previousButton.dataset.y;

      activeIndex = boundedIndex;
      overview = false;
      updateCamera();
      updateNextButton();
      ship.style.left = `${button.dataset.x}%`;
      ship.style.top = `${button.dataset.y}%`;
      if (samePlace) replayClass(ship, 'is-hopping');
      updateTrail(boundedIndex);
      progress.style.width = `${((boundedIndex + 1) / stops.length) * 100}%`;

      panel.classList.add('is-changing');
      window.clearTimeout(panelTimer);
      panelTimer = window.setTimeout(() => {
        date.textContent = button.dataset.date;
        chapter.textContent = button.dataset.chapter;
        place.textContent = button.dataset.place;
        description.textContent = button.dataset.description;
        count.textContent = `${String(boundedIndex + 1).padStart(2, '0')} / ${String(stops.length).padStart(2, '0')}`;
        panel.classList.remove('is-changing');
      }, 180);

      stops.forEach((item, itemIndex) => {
        item.setAttribute('aria-pressed', itemIndex === activeIndex ? 'true' : 'false');
        item.classList.toggle('is-visited', itemIndex <= activeIndex);
      });
      centerTimelineOn(button);
      bringStageIntoView();
    }

    // On stacked layouts, frame the map and story together like a game camera,
    // so the ship's move is visible after each step.
    function bringStageIntoView() {
      if (!stackedLayout.matches) return;
      const mapTop = mapFrame.getBoundingClientRect().top;
      const fits = mapFrame.offsetHeight + 240 < window.innerHeight;
      if (fits && Math.abs(mapTop) > 8) window.scrollBy({ top: mapTop, behavior: 'smooth' });
    }

    // Horizontal swipe on the map or the story card moves between stops.
    function enableSwipe(element) {
      let startX = 0;
      let startY = 0;
      let tracking = false;

      element.addEventListener('touchstart', (event) => {
        if (event.touches.length !== 1) return;
        startX = event.touches[0].clientX;
        startY = event.touches[0].clientY;
        tracking = true;
      }, { passive: true });

      element.addEventListener('touchend', (event) => {
        if (!tracking) return;
        tracking = false;
        const dx = event.changedTouches[0].clientX - startX;
        const dy = event.changedTouches[0].clientY - startY;
        if (Math.abs(dx) < 50 || Math.abs(dx) < Math.abs(dy) * 1.5) return;
        swipeHint?.classList.add('is-hidden');
        step(dx < 0 ? 1 : -1);
      }, { passive: true });
    }

    enableSwipe(mapFrame);
    enableSwipe(panel);

    // The docked mobile bar only shows while the map and story are on screen.
    if ('IntersectionObserver' in window) {
      new IntersectionObserver(([entry]) => {
        controls.classList.toggle('is-offscreen', !entry.isIntersecting);
      }, { rootMargin: '-30% 0px -25% 0px' }).observe(root);
    }

    updateTrail(0);
    stops[0]?.classList.add('is-visited');
    updateCamera();
    stackedLayout.addEventListener('change', updateCamera);
    phoneLayout.addEventListener('change', updateCamera);

    cameraToggle.addEventListener('click', () => {
      overview = !overview;
      updateCamera();
    });

    finale.querySelector('[data-restart]').addEventListener('click', () => activate(0));

    stops.forEach((button) => {
      button.addEventListener('click', () => activate(Number(button.dataset.stopIndex)));
    });

    previous.addEventListener('click', () => step(-1));
    next.addEventListener('click', () => step(1));

    document.addEventListener('keydown', (event) => {
      if (event.altKey || event.ctrlKey || event.metaKey) return;
      if (event.key === 'ArrowLeft') step(-1);
      if (event.key === 'ArrowRight') step(1);
    });
  }
</script>

<style>
  .journey-page {
    overflow: hidden;
  }

  .journey-heading {
    max-width: 720px;
    margin-bottom: var(--space-2xl);
  }

  .journey-heading h1 {
    margin-bottom: var(--space-sm);
  }

  .eyebrow,
  .stop-panel__eyebrow {
    color: var(--color-accent-soft);
    font-size: 0.78rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .journey-intro {
    max-width: 58ch;
    color: var(--color-text-muted);
    font-size: 1.05rem;
  }

  .journey-buy {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-md);
    flex-wrap: wrap;
    margin-top: var(--space-xl);
    padding-top: var(--space-lg);
    border-top: 1px solid var(--color-border);
  }

  .journey-buy__text {
    margin: 0;
    font-family: var(--font-heading);
    font-size: 1.25rem;
    color: var(--color-accent);
  }

  .journey-buy__actions {
    display: flex;
    gap: var(--space-sm);
    flex-wrap: wrap;
  }

  .journey-page .container {
    max-width: 1600px;
  }

  .journey-layout {
    display: grid;
    grid-template-columns: minmax(0, 1.7fr) minmax(300px, 1fr);
    align-items: center;
    gap: var(--space-2xl);
  }

  @media (max-width: 1080px) {
    .journey-layout,
    .timeline {
      width: 100vw;
      max-width: 100vw;
      margin-left: calc(50% - 50vw);
    }
  }

  .map-frame {
    position: relative;
    width: 100%;
    aspect-ratio: 3 / 2;
    overflow: hidden;
    background: var(--color-bg);
  }

  .map-stage {
    position: absolute;
    inset: 0;
    transform-origin: 0 0;
    transition: transform 1.25s cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  .journey-map {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .map-camera-toggle {
    position: absolute;
    top: var(--space-sm);
    right: var(--space-sm);
    z-index: 3;
    min-height: 36px;
    padding: 0 var(--space-md);
    border: 1px solid var(--color-border);
    border-radius: 999px;
    color: var(--color-accent);
    background: color-mix(in srgb, var(--color-bg) 92%, transparent);
    font: 500 0.8rem var(--font-body);
    cursor: pointer;
  }

  .map-camera-toggle[hidden] {
    display: none;
  }

  .map-camera-toggle:focus-visible {
    outline: 2px solid var(--color-accent-soft);
    outline-offset: 2px;
  }

  .journey-finale:not([hidden]) {
    display: grid;
    grid-template-columns: minmax(96px, 160px) 1fr;
    align-items: start;
    gap: var(--space-lg);
    padding: var(--space-xl) 0;
    animation: journey-finale-in 0.5s ease both;
  }

  @keyframes journey-finale-in {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
  }

  .journey-finale__cover {
    width: 100%;
    height: auto;
    box-shadow: 0 10px 24px rgba(26, 26, 24, 0.18);
  }

  .journey-finale h2 {
    margin-bottom: var(--space-sm);
    font-size: clamp(1.6rem, 2.6vw, 2.4rem);
  }

  .journey-finale h2:focus {
    outline: none;
  }

  .journey-finale__text {
    color: var(--color-text-muted);
    line-height: 1.7;
  }

  .journey-finale__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
    margin: var(--space-lg) 0 var(--space-md);
  }

  .journey-finale__restart {
    min-height: 44px;
    border: 0;
    padding: 0;
    color: var(--color-accent);
    background: transparent;
    font: 500 0.95rem var(--font-body);
    cursor: pointer;
  }

  .journey-finale__restart:hover {
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .journey-trail {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
    background: transparent;
    pointer-events: none;
  }

  .journey-trail__halo {
    fill: none;
    stroke: var(--color-bg);
    stroke-width: 2.8;
    stroke-linecap: round;
    opacity: 0.8;
  }

  .journey-trail__path {
    fill: none;
    stroke: var(--color-accent);
    stroke-width: 1.3;
    stroke-linecap: round;
    stroke-dasharray: 2.4 2.8;
    opacity: 1;
  }

  .journey-trail__dot {
    fill: var(--color-bg);
    stroke: var(--color-border);
    stroke-width: 0.7;
    opacity: 0.65;
    transition: fill 0.3s ease, stroke 0.3s ease, opacity 0.3s ease;
  }

  .journey-trail__dot.is-visited {
    fill: var(--color-accent);
    stroke: var(--color-bg);
    stroke-width: 0.9;
    opacity: 1;
  }

  .journey-trail__dot.is-current {
    opacity: 0;
  }

  .journey-ship {
    position: absolute;
    z-index: 2;
    width: calc(clamp(42px, 8.5%, 100px) * var(--ship-factor, 1));
    transform: translate(-50%, -55%);
    transition:
      left 1.25s cubic-bezier(0.2, 0.7, 0.2, 1),
      top 1.25s cubic-bezier(0.2, 0.7, 0.2, 1),
      width 1.25s cubic-bezier(0.2, 0.7, 0.2, 1);
    pointer-events: none;
  }

  .journey-ship.is-hopping {
    animation: journey-ship-hop 0.6s ease-out;
  }

  @keyframes journey-ship-hop {
    0%,
    100% {
      transform: translate(-50%, -55%) scale(1);
    }
    40% {
      transform: translate(-50%, -85%) scale(1.12);
    }
    70% {
      transform: translate(-50%, -50%) scale(0.96);
    }
  }

  .journey-ship__img {
    display: block;
    width: 100%;
    height: auto;
    transform-origin: 50% 85%;
    animation: journey-ship-idle 4.5s ease-in-out infinite;
  }

  @keyframes journey-ship-idle {
    0%,
    100% {
      transform: translateY(0) rotate(-1.4deg);
    }
    50% {
      transform: translateY(-6%) rotate(1.4deg);
    }
  }

  .map-caption {
    position: absolute;
    bottom: 3%;
    left: 3%;
    color: var(--color-accent);
    font-family: var(--font-heading);
    font-size: clamp(0.7rem, 1.1vw, 0.95rem);
    font-style: italic;
    pointer-events: none;
  }

  .stop-panel {
    min-width: 0;
    padding: var(--space-xl) 0;
    touch-action: pan-y;
  }

  .stop-panel__content {
    display: grid;
  }

  .stop-panel__live,
  .stop-panel__sizer {
    grid-area: 1 / 1;
    min-width: 0;
  }

  .stop-panel__sizer {
    visibility: hidden;
    pointer-events: none;
  }

  /* Mirrors the live h2 so the sizer measures the same height. */
  .stop-panel__sizer-title {
    margin: 0 0 var(--space-sm);
    font-family: var(--font-heading);
    font-weight: 500;
    font-size: clamp(2rem, 3vw, 3rem);
    line-height: 1.25;
  }

  .stop-panel__live {
    transition: opacity 0.18s ease, transform 0.18s ease;
  }

  .stop-panel.is-changing .stop-panel__live {
    opacity: 0;
    transform: translateX(-12px);
  }

  .stop-panel.is-changing[data-direction='back'] .stop-panel__live {
    transform: translateX(12px);
  }

  .map-frame {
    touch-action: pan-y;
  }

  .stop-panel__eyebrow {
    margin-bottom: var(--space-md);
  }

  .stop-panel h2 {
    margin-bottom: var(--space-sm);
    font-size: clamp(2rem, 3vw, 3rem);
  }

  .stop-panel__place {
    color: var(--color-accent-soft);
    font-family: var(--font-heading);
    font-size: 1.3rem;
    font-style: italic;
  }

  .stop-panel__description {
    color: var(--color-text-muted);
