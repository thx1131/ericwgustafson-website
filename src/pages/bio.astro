---
import Layout from '../layouts/Layout.astro';
---

<!--
  Photo placeholder: add the final file at public/images/eric-gustafson.jpg
-->
<Layout title="Biography — Eric Gustafson" description="Biography of Eric Gustafson, author of Mexico Viking.">
  <section class="section">
    <div class="container bio">
      <div class="bio__photo">
        <img src="/images/eric-gustafson.jpg" alt="Portrait of Eric Gustafson" />
      </div>

      <div class="bio__text">
        <div class="section-heading section-heading--underline">
          <h1>Biography</h1>
        </div>

        <p>
          Eric Gustafson holds a Bachelor's degree in Economics from Duke University, a
          Master's in Business Administration from ITESM, and a Doctorate in Education from
          the University of Massachusetts.
        </p>
        <p>
          For thirty-eight years he served as a board member and chairman of the board of the
          American School Foundation. At ITESM, he founded the Computer Administration major
          and the Teaching Improvement Center, and taught Computer Science.
        </p>
        <p>
          In business, his work has ranged from strategic planning — including the negotiated
          acquisition of Clemente Jacques for FEMSA — to founding and leading Swedish
          Enterprises and developing real estate.
        </p>
        <p>
          He is the author of seven books, including <em>Mexico Viking</em> and <em>Joe and
          Running Bear</em>, along with three chapters contributed to other publications and
          numerous magazine articles. His writing consistently returns to a single
          throughline: environmental conservation and sustainable development in Mexico, the
          country and the natural world he has spent a lifetime devoted to.
        </p>
        <p>
          Eric divides his time between family, faith, and the outdoors — a lifelong athlete
          across baseball, football, basketball, and swimming, now settled into golf and
          hiking.
        </p>
      </div>
    </div>
  </section>
</Layout>

<style>
  .bio {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-2xl);
  }

  @media (min-width: 768px) {
    .bio {
      grid-template-columns: 1fr 2fr;
      align-items: start;
    }
  }

  .bio__photo {
    background: var(--color-bg-muted);
    border-radius: var(--radius);
    overflow: hidden;
    aspect-ratio: 4 / 5;
    max-width: 340px;
  }

  .bio__photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .bio__text p {
    max-width: 68ch;
  }
</style>
