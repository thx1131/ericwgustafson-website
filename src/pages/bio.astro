---
import Layout from '../layouts/Layout.astro';
---

<!--
  Texto de marcador de posición: reemplazar con la biografía real de Eric Gustafson.
  Foto de marcador de posición: agregar el archivo definitivo en public/images/eric-gustafson.jpg
-->
<Layout title="Biography — Eric Gustafson" description="Biography of Eric Gustafson, author of Mexico Viking.">
  <section class="section">
    <div class="container bio">
      <div class="bio__photo">
        <img src="/images/eric-gustafson.jpg" alt="Portrait of Eric Gustafson" />
      </div>

      <div class="bio__text">
        <div class="section-heading section-heading--underline">
          <h1>Biography</h1>
        </div>

        <p>
          Eric Gustafson is a writer and the author of <strong>Mexico Viking</strong>, a novel
          that weaves together Scandinavian and Mexican roots through the story of Nils, a
          character shaped by two worlds. His writing grows out of a lifelong fascination with
          the landscapes that shape people: the wetlands and deserts of Mexico, the mountains
          of Wyoming, and the vastness of Alaska.
        </p>
        <p>
          With a background and interests spanning aviation, hunting, and environmental
          conservation, Eric brings to his stories a perspective built on firsthand experience
          rather than desk research. His work explores how identity is shaped at the border
          between cultures, and how a person's relationship with the land can define the
          course of an entire life.
        </p>
        <p>
          <em>Mexico Viking</em> is the result of years spent observing these intersections:
          between north and south, tradition and change, personal adventure and responsibility
          toward the natural world. Eric continues writing from that same curiosity, with new
          projects underway.
        </p>
      </div>
    </div>
  </section>
</Layout>

<style>
  .bio {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-2xl);
  }

  @media (min-width: 768px) {
    .bio {
      grid-template-columns: 1fr 2fr;
      align-items: start;
    }
  }

  .bio__photo {
    background: var(--color-bg-muted);
    border-radius: var(--radius);
    overflow: hidden;
    aspect-ratio: 4 / 5;
    max-width: 340px;
  }

  .bio__photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .bio__text p {
    max-width: 68ch;
  }
</style>
