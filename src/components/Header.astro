---
import Nav from './Nav.astro';
import { site } from '../data/site.js';
---

<header class="header">
  <div class="container header__inner">
    <a href="/" class="header__brand">
      <img class="header__logo" src="/images/logo-eric-gustafson.png" alt="" />
      <span class="header__brand-text">
        <span class="header__name">{site.author}</span>
      </span>
    </a>
    <Nav />
  </div>
</header>

<style>
  .header {
    background: var(--color-bg);
    border-bottom: 1px solid var(--color-border);
  }

  .header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: var(--space-md);
    padding-top: var(--space-md);
    padding-bottom: var(--space-md);
  }

  .header__brand {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    line-height: 1.2;
    border-bottom: none;
  }

  .header__brand:hover {
    border-bottom: none;
  }

  .header__logo {
    width: 40px;
    height: 40px;
  }

  .header__brand-text {
    display: flex;
    flex-direction: column;
  }

  .header__name {
    font-family: var(--font-heading);
    font-weight: 500;
    font-size: 1.25rem;
    color: var(--color-accent);
    letter-spacing: 0;
  }

</style>
